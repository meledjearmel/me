includes:
    # Dette existante (513 erreurs au 2026-10-23), à résorber fichier par fichier : toute
    # nouvelle erreur reste bloquante. Après une correction : composer types:check -- --generate-baseline phpstan-baseline.neon.
    - phpstan-baseline.neon
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    # Config vendor-publié par spatie/laravel-medialibrary : référence la classe
    # Pro (payante) TemporaryUpload, jamais installée puisqu'on n'utilise pas Pro.
    excludePaths:
        - config/media-library.php

    level: 7
